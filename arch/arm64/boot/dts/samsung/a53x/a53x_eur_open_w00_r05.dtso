		samsung,pin-pud = <0>;
	};

	xclkout_nc: xclkout_nc {
		samsung,pins = "gpq0-3";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
	};
};

&pinctrl_0 {

	nfc_firm: nfc_firm {
		samsung,pins ="gpc5-0";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <0>;
		samsung,pin-con-pdn =<3>;
		samsung,pin-pud-pdn = <0>;
	};

	nfc_firm_nc: nfc_firm_nc {
		samsung,pins = "gpc5-0";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
	};
};

&pinctrl_0 {

	nfc_en: nfc_en {
		samsung,pins = "gpc4-0";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <1>;
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <0>;
	};

	nfc_en_nc: nfc_en_nc {
		samsung,pins = "gpc4-0";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
	};
};

&pinctrl_0 {

	nfc_clk_req: nfc_clk_req {
		samsung,pins = "gpa1-1";
		samsung,pin-function = <2>;
		samsung,pin-pud = <1>;
	};

	nfc_clk_req_nc: nfc_clk_req_nc {
		samsung,pins = "gpa1-1";
		samsung,pin-function = <0x0>;
		samsung,pin-pud = <1>;
	};
};

&hsi2c_4 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	samsung,i2c-max-bus-freq = <0x61a80>;
	samsung,reset-before-trans;
	pinctrl-names = "default";
	pinctrl-0 = <&nfc_i2c_bus>;

	sec_nfc: sec-nfc@27 {
		compatible = "sec-nfc";
		reg = <0x27>;
		interrupts = <2 0 0>;
		interrupt-parent = <&gpa1>;
		sec-nfc,ven-gpio = <&gpc4 0 0>;
		sec-nfc,firm-gpio = <&gpc5 0 0>;
		sec-nfc,irq-gpio = <&gpa1 2 0>;
		sec-nfc,clk_req-gpio = <&gpa1 1 0xf>;
		sec-nfc,coldreset-gpio = <&gpp3 5 0>;
		nfc_pvdd-supply = <&l25_reg>;
		sec-nfc,ldo_control;
		clocks = <&clock ((1600) + 0)>;
		clock-names = "oscclk_nfc";
		sec-nfc,nfc_ap_clk;
		pinctrl-names = "default", "nfc_nc";
		pinctrl-0 = <&nfc_en &nfc_firm &xclkout &nfc_clk_req>;
		pinctrl-1 = <&nfc_en_nc &nfc_firm_nc &xclkout_nc &nfc_clk_req_nc>;
	};
};

