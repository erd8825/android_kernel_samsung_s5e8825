/ {
	fragment@panel_drv {
		target-path = "/";

		__overlay__ {

			ffc_1108: ffc_1108 {
				osc = <0x2c434>;
				hs-clk = <0x454>;
				command = [c5 0d 10 80 45 53 c7];
			};

			ffc_1124: ffc_1124 {
				osc = <0x2c434>;
				hs-clk = <0x464>;
				command = [c5 0d 10 80 45 52 96];
			};

			ffc_1125: ffc_1125 {
				osc = <0x2c434>;
				hs-clk = <0x465>;
				command = [c5 0d 10 80 45 52 83];
			};

			s6e3fc3: s6e3fc3_ddi {
				id = <0x1083>;
				mode = <2>;
				resolution = <0x438 0x960>;
				size = <0x43 0x96>;
				timing,refresh = <0x3c>;
				timing,h-porch = <2 2 2>;
				timing,v-porch = <0xf 8 1>;
				timing,dsi-hs-clk = <0x454>;
				timing,pmsk = <2 0xaa 2 0x7627 0xd 4 0 0 0 0 0 0 0 0>;
				timing,dsi-escape-clk = <0x14>;
				mic_en = <0>;
				mic_ratio = <2>;
				mic_ver = <2>;
				type_of_ddi = <0>;
				dsc_en = <1>;
				dsc_cnt = <1>;
				dsc_slice_num = <2>;
				dsc_slice_h = <0x28>;
				data_lane = <4>;
				cmd_underrun_cnt = <0x26cf>;
				mres_en = <1>;
				mres_number = <1>;
				mres_width = <0x438>;
				mres_height = <0x960>;
				mres_dsc_width = <0x21c>;
				mres_dsc_height = <0x28>;
				mres_dsc_en = <1>;
				default_mode = <1>;
				display_mode = <0x438 0x960 0x78 0x83b 1 0x21c 0x28 0x438 0x960 0x3c 0x1f37 1 0x21c 0x28>;
				hdr_num = <0>;
				color_mode = <0 7 9>;
				dynamic_mipi_tbl = <&dsim_freq_1108 &dsim_freq_1124 &dsim_freq_1125>;
				dynamic_mipi_ffc0 = <&ffc_1108 &ffc_1124 &ffc_1125>;
			};

			s6e3fc3_v2: s6e3fc3_v2_ddi {
				id = <0x800004>;
				mode = <2>;
				resolution = <0x438 0x960>;
				size = <0x46 0x9b>;
				timing,refresh = <0x3c>;
				timing,h-porch = <2 2 2>;
				timing,v-porch = <0xf 8 1>;
				timing,dsi-hs-clk = <0x67c>;
				timing,pmsk = <4 0xff 1 0 0xd 4 0 0 0 0 0 0 0 0>;
				timing,dsi-escape-clk = <0x14>;
				mic_en = <0>;
				mic_ratio = <0>;
				mic_ver = <0>;
				type_of_ddi = <0>;
				dsc_en = <1>;
				dsc_cnt = <1>;
				dsc_slice_num = <2>;
				dsc_slice_h = <0x28>;
				data_lane = <4>;
				cmd_underrun_cnt = <0x26cf>;
				mres_en = <1>;
				mres_number = <1>;
				mres_width = <0x438>;
				mres_height = <0x960>;
				mres_dsc_width = <0x21c>;
				mres_dsc_height = <0x28>;
				mres_dsc_en = <1>;
				default_mode = <1>;
				display_mode = <0x438 0x960 0x5a 0x13e5 1 0x21c 0x28 0x438 0x960 0x3c 0x26cf 1 0x21c 0x28>;
				hdr_num = <0>;
			};

			s6e3fc3_m34x_ddi: s6e3fc3_m34x_ddi {
				size = <0x46 0x95>;
				hdr_num = <0>;
			};

			mafpc_0: mafpc_0 {
				compatible = "samsung,panel-mafpc";
				status = "okay";
			};

			panel_drv_0: panel_drv_0 {
				status = "okay";
				compatible = "samsung,panel-drv";
				panel,id = <0>;
				pinctrl-names = "default";
				pinctrl-0 = <&disp_rst_default &disp_det_default &conn_det_default &disp_te_default>;

				s6e3fc3_a53x_power_ctrl: s6e3fc3_a53x_power_ctrl {

					actions {

						fc3_a53x_vci_on: vci-on {
							type = <3>;
							reg = <&ddi_vci>;
						};

						fc3_a53x_vdd3_on: vdd3-on {
							type = <3>;
							reg = <&ddi_vdd3>;
						};

						fc3_a53x_vci_off: vci-off {
							type = <4>;
							reg = <&ddi_vci>;
						};

						fc3_a53x_vdd3_off: vdd3-off {
							type = <4>;
							reg = <&ddi_vdd3>;
						};

						fc3_a53x_delay_1ms: delay-1ms {
							type = <1>;
							value = <1>;
						};

						fc3_a53x_delay_10ms: delay-10ms {
							type = <1>;
							value = <10>;
						};

						fc3_a53x_reset_high: reset-high {
							type = <7>;
							gpio = <&disp_reset>;
						};

						fc3_a53x_reset_low: reset-low {
							type = <8>;
							gpio = <&disp_reset>;
						};
					};

					sequences {
						panel_boot_on = <&fc3_a53x_vci_on &fc3_a53x_vdd3_on>;
						panel_power_on = <
							&fc3_a53x_vci_on &fc3_a53x_vdd3_on
							&fc3_a53x_delay_10ms
							&fc3_a53x_reset_high &fc3_a53x_delay_10ms
						>;
						panel_power_off = <
							&fc3_a53x_reset_low &fc3_a53x_delay_1ms
							&fc3_a53x_vci_off &fc3_a53x_delay_10ms
							&fc3_a53x_vdd3_off
						>;
					};
				};

				panels {

					s6e3fc3_a53x: s6e3fc3_a53x {
						ddi = <&s6e3fc3>;
						ap-vendor-setting = <&s6e3fc3>;
						display-mode = <&a53x_panel_display_modes>;
						power-ctrl = <&s6e3fc3_a53x_power_ctrl>;
						freq-hop = <&a53x_freq_hop_table>;
						dqe-suffix = "s6e3fc3_a53x";
						id-mask = <0x00 0x00>;
					};
				};

				panel-lut {
					panel_0 = <&s6e3fc3_a53x>;
				};

				gpios {

					disp_reset: disp-reset {
						gpios = <&gpc7 0 1>; /* ACTIVE_LOW */
						dir = <0>; /* OUT */
						irq-type = <0x0>; /* NONE */
					};

					disp_det: disp-det {
						gpios = <&gpp2 6 1>; /* 0:OK, 1:NOK(active) */
						dir = <1>; /* IN */
						irq-type = <0x2>; /* FALLING EDGE */

						irq-pend {
							reg = <0x0 0x15850A34 0x0>;
							bit = <0x2>;
						};
					};

					conn_det: conn-det {
						gpios = <&gpa0 2 0>;
						dir = <1>;
						irq-type = <0x00002001>; //RISING EDGE | ONE_SHOT
					};

					pcd: pcd {
						gpios = <&gpa0 4 1>; /* 0:NOK(active) 1:OK */
						dir = <1>; /* IN */
						irq-type = <0x2>; /* FALLING EDGE */
					};

					disp_te: disp-te {
						gpios = <&gpg0 1 0>; /* 0:NOK(active) 1:OK */
						dir = <1>; /* IN */
						irq-type = <0x0>; /* NONE */
					};
				};

				regulators {

					ddi_vci: ddi-vci {
						regulator = <&s_l27_reg>;
						type = <1>;
						def-voltage = <3000000>;
					};

					ddi_vdd3: ddi-vdd3 {
						regulator = <&l23_reg>;
						type = <1>;
						def-voltage = <1800000>;
					};
				};
			};
		};
	};
};

&dsim_modes {

	dsim-modes {

		1080x2400@120hs {
			mode-name = "1080x2400@120hs";
			pmsk = <2 0xaa 2 0x7627 0xd 4 0 0 0 0 0 0 0 0>;
			hs-clk = <0x454>;
			esc-clk = <0x14>;
			cmd_underrun_cnt = <0x83b>;
		};

		1080x2400@60phs {
			mode-name = "1080x2400@60phs";
			pmsk = <2 0xaa 2 0x7627 0xd 4 0 0 0 0 0 0 0 0>;
			hs-clk = <0x454>;
			esc-clk = <0x14>;
			cmd_underrun_cnt = <0x83b>;
		};

		1080x2400@30ns {
			mode-name = "1080x2400@30ns";
			pmsk = <2 0xaa 2 0x7627 0xd 4 0 0 0 0 0 0 0 0>;
			hs-clk = <0x454>;
			esc-clk = <0x14>;
			cmd_underrun_cnt = <0x4c2f>;
		};
	};
};

/ {
	fragment@panel_display_mode {
		target-path = "/";

		__overlay__ {

			a53x_panel_display_modes: a53x_panel_display_modes {
				native-mode = <&a53x_panel_display_mode_1080x2400_120hs>;
				exposed-mode = <&a53x_panel_display_mode_1080x2400_120hs &a53x_panel_display_mode_1080x2400_60phs &a53x_panel_display_mode_1080x2400_30ns>;

				a53x_panel_display_mode_1080x2400_120hs: a53x_panel_display_mode_1080x2400_120hs {
					id = "1080x2400_120HS";
					width = <0x438>;
					height = <0x960>;
					refresh_rate = <0x78>;
					refresh_mode = <1>;
					panel_refresh_rate = <0x78>;
					panel_refresh_mode = <1>;
					panel_te_st = <0>;
					panel_te_ed = <0>;
					panel_te_sw_skip_count = <0>;
					panel_te_hw_skip_count = <0>;
					panel_h_porch = <0 0 0>;
					panel_v_porch = <0x10 0 0>;
					dsc_en = <1>;
					dsc_cnt = <1>;
					dsc_slice_num = <2>;
					dsc_slice_w = <0x21c>;
					dsc_slice_h = <0x28>;
					cmd_lp_ref = <0x83b>;
				};

				a53x_panel_display_mode_1080x2400_60phs: a53x_panel_display_mode_1080x2400_60phs {
					id = "1080x2400_60HS_120HS_TE_HW_SKIP_1";
					width = <0x438>;
					height = <0x960>;
					refresh_rate = <0x3c>;
					refresh_mode = <2>;
					panel_refresh_rate = <0x78>;
					panel_refresh_mode = <1>;
					panel_te_st = <0>;
					panel_te_ed = <0>;
					panel_te_sw_skip_count = <0>;
					panel_te_hw_skip_count = <1>;
					panel_h_porch = <0 0 0>;
					panel_v_porch = <0x10 0 0>;
					dsc_en = <1>;
					dsc_cnt = <1>;
					dsc_slice_num = <2>;
					dsc_slice_w = <0x21c>;
					dsc_slice_h = <0x28>;
					cmd_lp_ref = <0x83b>;
				};

				a53x_panel_display_mode_1080x2400_30ns: a53x_panel_display_mode_1080x2400_30ns {
					id = "1080x2400_30NS";
					width = <0x438>;
					height = <0x960>;
					refresh_rate = <0x1e>;
					refresh_mode = <0>;
					panel_refresh_rate = <0x1e>;
					panel_refresh_mode = <0>;
					panel_te_st = <0>;
					panel_te_ed = <0>;
					panel_te_sw_skip_count = <0>;
					panel_te_hw_skip_count = <0>;
					panel_h_porch = <0 0 0>;
					panel_v_porch = <0x10 0 0>;
					dsc_en = <1>;
					dsc_cnt = <1>;
					dsc_slice_num = <2>;
					dsc_slice_w = <0x21c>;
					dsc_slice_h = <0x28>;
					cmd_lp_ref = <0x4c2f>;
				};
			};
		};
	};
};

#include "../s5e8825_samsung_debug.dtsi"

&hsi2c_5 {
	status = "okay";

	sm5451_charger: sm5451@63 {
		compatible = "siliconmitus,sm5451";
		reg = <0x63>;
		sm5451,freq_byp = <1>;
	};
};

/* #include "../s2mf301.dtsi" */
/* From s2mf301.py */
&pinctrl_0 {

	if_pmic_irq: if_pmic_irq {
		samsung,pins = "gpa0-5";
		samsung,pin-function = <0x0>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0x0>;
	};
};

&pinctrl_0 {

	usbpd_irq: usbpd_irq {
		samsung,pins = "gpa0-6";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0x2>;
	};
};

&hsi2c_5 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	samsung,i2c-max-bus-freq = <400000>;

	sm5714@49 {
		status = "okay";
		compatible = "siliconmitus,sm5714mfd";
		reg = <0x49>;
		pinctrl-names = "default";
		pinctrl-0 = <&if_pmic_irq>;
		sm5714,irq-gpio = <&gpa0 5 0>;
		sm5714,wakeup;
	};
};

&hsi2c_10 {
	i2c-gpio,delay-us = <5>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	samsung,i2c-max-bus-freq = <0x61a80>;

	usbpd-sm5714@33 {
		status = "okay";
		compatible = "sm5714-usbpd";
		reg = <0x33>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbpd_irq>;
		usbpd,usbpd_int = <&gpa0 6 0>;
		support_pd_role_swap;

		pdic-manager {
			pdic,max_power = <0x1388>;
			pdic_op_power = <0x9c4>;
			pdic_max_voltage = <0x1770>;
			pdic_max_current = <0x7d0>;
			pdic,min_current = <0x1f4>;
			pdic,giveback = <0>;
			pdic,usb_com_capable = <1>;
			pdic,no_usb_suspend = <1>;
			source,max_voltage = <0x1388>;
			source,min_voltage = <0xfa0>;
			source,max_power = <0x9c4>;
		};
	};
};

/* /home/dpi/qb5_8814/workspace/P4_1716/kernel/kmodule/mfd/VINCE/slsi/s2mf301/s2mf301.a26xs.dtsi */
&hsi2c5_bus {
	samsung,pin-con-pdn = <3>;
	samsung,pin-pud-pdn = <0>;
};

&hsi2c10_bus {
	samsung,pin-pud-pdn = <3>;
};

&pinctrl_0 {

	hall_irq: hall_irq {
		samsung,pins = "gpa0-1";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <0>;
	};
};

&pinctrl_0 {

	certify_hall_irq: certify_hall_irq {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <0>;
	};
};

/* #include "../pmic_S2MPU14.dtsi" */
/* From pmic_S2MPU14.py */
&acpm_mfd_bus1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	s2mpu14mfd@1f {
		compatible = "samsung,s2mpu14mfd";
		acpm-ipc-channel = <2>;
		s2mpu14,wakeup = "enabled";
		reg = <0x2f>;
		wtsr_en = <1>; /* 1 : enable , 0 : disable */
		/* SEL_VGPIO0S~18S (CONTROL_SEL#) */
		sel_vgpio = <0x0A 0x68 0xB1 0x33 0x03 0x68 0xA1 0x21 0x73 0x33
			0x53 0x56 0xC5 0x7C 0x77 0x33 0x33 0x33 0x03>;

		s2mpu14_gpio: s2mpu14-gpio {
			gpio-controller;
			#gpio-cells = <2>;
			samsung,npins = <4>;
			status = "okay";

			ese_check_default: ese_check_default {
				pins = "gpio_s6";
				pmic-gpio,input-enable;
				pmic-gpio,pull-disable;
				pmic-gpio,drive-strength = <2>;
				samsung,pin-con-pdn = <2>;
				samsung,pin-pud-pdn = <0>;
			};
		};

		regulators {

			s_b1_reg: BUCK1 {
				regulator-name = "vdd_npu";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>; /* V_PWREN_NPU */
			};

			s_b2_reg: BUCK2 {
				regulator-name = "vdd_cpucl0";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>; /* V_PWREN_CPUCL0 */
			};

			s_b3_reg: BUCK3 {
				regulator-name = "vdd_cpucl1";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>; /* V_PWREN_CPUCL1 */
			};

			/*
						s_b4_reg: BUCK4 {
							regulator-name = "vdd_gnss";
							regulator-min-microvolt = <400000>;
							regulator-max-microvolt = <1300000>;
							regulator-always-on;
							regulator-ramp-delay = <6000>;
							regulator-initial-mode = <3>;
						};

			 */
			s_b5_reg: BUCK5 {
				regulator-name = "vdd_mif";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>; /* V_PWREN_MIF */
			};

			s_b6_reg: BUCK6 {
				regulator-name = "vdd_cam";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>; /* V_PWREN_CAM */
			};

			s_b7_reg: BUCK7 {
				regulator-name = "vdd_lldo1s";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1400000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <3>;
			};

			s_b8_reg: BUCK8 {
				regulator-name = "vdd_lldo2s";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1400000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <3>;
			};

			s_bb_reg: BUCKB {
				regulator-name = "vdd_hldo";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3600000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <3>;
			};

			s_l1_reg: LDO1 {
				regulator-name = "vdd_ldo1s";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-initial-mode = <1>;
				regulator-always-on;
			};

			s_l2_reg: LDO2 {
				regulator-name = "vdd_ldo2s";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-initial-mode = <1>;
				regulator-always-on;
			};

			/*
						s_l3_reg: LDO3 {
							regulator-name = "${LDO3_name}";
							regulator-min-microvolt = <${LDO3_Vmin}>;
							regulator-max-microvolt = <${LDO3_Vmax}>;
							${LDO3_opt_properties}
							${LDO3_basic_properties}
						};
			 */
			s_l4_reg: LDO4 {
				regulator-name = "vdd_ldo4s";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-initial-mode = <1>;
				regulator-always-on;
			};

			s_l5_reg: LDO5 {
				regulator-name = "vdd_ldo5s";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-initial-mode = <1>;
				regulator-always-on;
			};

			s_l6_reg: LDO6 {
				regulator-name = "vdd_ldo6s";
				regulator-min-microvolt = <725000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-initial-mode = <1>;
				regulator-always-on;
			};

			/*
						s_l7_reg: LDO7 {
							regulator-name = "${LDO7_name}";
							regulator-min-microvolt = <${LDO7_Vmin}>;
							regulator-max-microvolt = <${LDO7_Vmax}>;
							${LDO7_opt_properties}
							${LDO7_basic_properties}
						};
			 */
			s_l8_reg: LDO8 {
				regulator-name = "vdd_ldo8s";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
				regulator-initial-mode = <3>;
				regulator-always-on;
			};

			/*
						s_l9_reg: LDO9 {
							regulator-name = "${LDO9_name}";
							regulator-min-microvolt = <${LDO9_Vmin}>;
							regulator-max-microvolt = <${LDO9_Vmax}>;
