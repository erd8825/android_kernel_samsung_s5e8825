/* #include "../regulator-fixe-1.dtsi" */
/* From regulator-fixed.py */
/*
 * This pinctrl code is only for PULL state change.
 * IN-OUT setting is set to OUTPUT at fixed-regulator probe.
 */
&pinctrl_4 {

	ldo_gpio0: ldo_gpio0 {
		samsung,pins = "gpf1-0";
		samsung,pin-function = <0x1>;
		samsung,pin-pud = <0>;
	};
};

/ {
	fragment@model {
		target-path = "/";

		__overlay__ {
			#address-cells = <2>;
			#size-cells = <1>;

			shub {
				pinctrl-names = "default";
				sensor-vdd-regulator = "VDD_SENSOR_1P8";
				compatible = "shub";
				acc-motor-coef = <0>;
				acc-lsm6dsotr-position = <2>;
				mag-ak09918c-position = <7>;
				mag-ak09918c-array = [af 59 e3 02 97 8c ff ba d0 35 c4 53 b3 23 01 77 ff 72 44 00 bf 03 3a 8f 0d fb 1e];
				light-position = <0x19 0x50 3 7 2 0>;
				pressure-sw-offset = <0xffffffbe>;
			};

			sec_reloc_gpio: samsung,reloc_gpio {
				compatible = "samsung,reloc_gpio";
				status = "okay";
				sec,gpio-label = "reloc_gpio";
				sec,reloc-base = <0>;
			};

			gpio_keys {
				status = "okay";
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_voldown &key_volup>;

				button@2 {
					label = "gpio-keys: KEY_VOLUMEDOWN";
					linux,code = <114>;
					gpios = <&gpa0 7 0xf>;
					gpio-key,wakeup;
					debounce-interval = <0xf>;
				};

				button@3 {
					label = "gpio-keys: KEY_VOLUMEUP";
					linux,code = <115>;
					gpios = <&gpa1 0 0xf>;
					gpio-key,wakeup;
					debounce-interval = <0xf>;
				};
			};
		}; /* end of __overlay__ */
	}; /* end of fragment */
};

&pinctrl_0 {

	stm_attn_irq: stm_attn_irq {
		samsung,pins = "gpa0-3";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
	};

	stm_attn_input: stm_attn_input {
		samsung,pins = "gpa0-3";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
	};
};

&hsi2c_6 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "ok";
	samsung,reset-before-trans;

	tsp_stm: touchscreen@49 {
		status = "disabled";
		compatible = "stm,stm_ts";
		reg = <0x49>;
		pinctrl-names = "on_state", "off_state";
		pinctrl-0 = <&stm_attn_irq>;
		pinctrl-1 = <&stm_attn_input>;
		tsp_io_ldo-supply = <&fixed_regulator0>;
		tsp_avdd_ldo-supply = <&s_l16_reg>;
		sec,irq_gpio = <&gpa0 3 0>;
		sec,project_name = "a53x", "";
		sec,bringup = <1>;
		sec,ss_touch_num = <1>;
		sec,tclm_level = <1>;
		sec,area-size = <0x85 0x10a 0x155>;
		sec,max_coords = <0x1000 0x1000>;
		enable_settings_aot;
		support_fod;
		support_fod_lp_mode;
		support_mis_calibration_test;
		support_ear_detect_mode;
		support_open_short_test;
		sec,regulator_boot_on;
	};
};

&pinctrl_6 {

	ese_spi_bus_suspend: ese_spi_bus_suspend {
		samsung,pins = "gpp0-0", "gpp0-1", "gpp0-2";
		samsung,pin-function = <0>;
		samsung,pin-pud = <1>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <2>;
		samsung,pin-pud-pdn = <1>;
	};

	ese_spi_cs_suspend: ese_spi_cs_suspend {
		samsung,pins = "gpp0-3";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-val = <1>;
		samsung,pin-con-pdn = <1>;
		samsung,pin-pud-pdn = <0>;
	};

	ese_spi_bus: ese_spi_bus {
		samsung,pins = "gpp0-0", "gpp0-1", "gpp0-2";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};

	ese_spi_cs: ese_spi_cs {
		samsung,pins = "gpp0-3";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

&spi_0 {
	status = "ok";
	pinctrl-names = "ese_active", "ese_suspend";
	pinctrl-0 = <&ese_spi_bus &ese_spi_cs>;
	pinctrl-1 = <&ese_spi_bus_suspend &ese_spi_cs_suspend>;

	ese_spi@0 {
		compatible = "ese_p3";
		reg = <0>;
		spi-max-frequency = <0x6acfc0>;
		check_ese = <&s2mpu14_gpio 6 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ese_check_default>;
		gpio-controller;
		#gpio-cells = <2>;
		ese_p3,cs-gpio = <&gpp0 3 0>;

		controller-data {
			samsung,spi-feedback-delay = <0>;
			samsung,spi-chip-select-mode = <0>;
		};
	};
};

/ {
	fragment@ese_platform {
		target-path = "/";

		__overlay__ {

			ese_platform {
				compatible = "p3_platform";
			};
		};
	};
};

&pinctrl_6 {

	nfc_i2c_bus: nfc_i2c_bus {
