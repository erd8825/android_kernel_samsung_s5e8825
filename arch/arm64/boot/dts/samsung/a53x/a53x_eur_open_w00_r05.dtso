/dts-v1/;
/plugin/;

#include <dt-bindings/battery/sec-battery.h>
#include <dt-bindings/clock/s5e8825.h>
#include <dt-bindings/camera/exynos_is_dt.h>
#include <dt-bindings/display/panel-display.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/s5e8825.h>
#include <dt-bindings/soc/samsung/exynos-cpif.h>
#include <dt-bindings/soc/samsung/exynos-dit.h>

/ {
	fragment@smd {
		target-path = "/";

		__overlay__ {

			smd: samsung_mobile_device {
				compatible = "simple-bus";

				/* #include "../common/input_booster_s5e8825_k66-1.dtsi" */
				/* From input_booster_s5e8825_k66.py */
				/*
				 * Samsung Mobile Input-Booster device tree
				 *
				 * Copyright (c) 2018 Samsung Electronics Co., Ltd.
				 *		http://www.samsung.com
				 *
				 * This program is free software; you can redistribute it and/or modify
				 * it under the terms of the GNU General Public License version 2 as
				 * published by the Free Software Foundation.
				 */
				input_booster {
					status = "okay";
					compatible = "input_booster";
					max_resource_count = "7";
					max_cluster_count = "3";
					#address-cells = <1>;
					#size-cells = <0>;
					/* Each Cpu Cluster Start Cpu */
					cpu_cluster_policy = "7,4,0";
					/* < CLUSTER2, CLUSTER1, CLUSTER0, MIF, INT, HMP, UCC> */
					ib_release_values = "0,0,0,0,0,0,0";
					/* Select Allowed Resource Index Group */
					allowed_resources = "1,3,4";

					booster_key@1 {
						input_booster,label = "key";
						input_booster,type = <0>;
						input_booster,head_time = <0x1f4>;
						input_booster,tail_time = <0>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x177000 0>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0 0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@2 {
						input_booster,label = "touchkey";
						input_booster,type = <1>;
						input_booster,head_time = <0>;
						input_booster,tail_time = <0xc8>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x177000 0>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0 0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@3 {
						input_booster,label = "touch";
						input_booster,type = <2>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x119400 0x101d00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@4 {
						input_booster,label = "multitouch";
						input_booster,type = <3>;
						input_booster,head_time = <0x3e8>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x119400 0x101d00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@5 {
						input_booster,label = "keyboard";
						input_booster,type = <4>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x15f900 0x101d00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@6 {
						input_booster,label = "mouse";
						input_booster,type = <5>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x15f900 0x101d00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@7 {
						input_booster,label = "mouse_wheel";
						input_booster,type = <6>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x15f900 0>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@8 {
						input_booster,label = "pen_hover";
						input_booster,type = <7>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x15f900 0x101d00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0 0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};

					booster_key@9 {
						input_booster,label = "pen";
						input_booster,type = <8>;
						input_booster,head_time = <0xc8>;
						input_booster,tail_time = <0x258>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x1a5e00 0x119400>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0 0>;
							};
						};
					};
				};

				/* #include "../nc.dtsi" */
				/* From nc.py */
				/* #include "../kq_mesh.dtsi" */
				/* From kq_mesh.py */
				kq-mesh {
					compatible = "samsung,kq-mesh";
					status = "okay";

					features {
					};
				};

				/* #include "../vibrator_vib_info.dtsi" */
				/* From vibrator_vib_info.py */
				vib_info: vibrator_info {
					status = "okay";
					compatible = "samsung,vib-info";
					functions = "";
					samsung,intensities = <>;
					samsung,haptic_intensities = <>;
				};

				sm5714_charger: sm5714-charger {
					status = "disable";
					compatible = "samsung,sm5714-charger";
				};

				sec_battery: battery {
					battery,otg_name = "sm5714-otg";
					battery,fgsrc_switch_name = "sm5714-fuelgauge"; /* Fuelgauge voltage source */
					/* #include "../battery_common.dtsi" */
					/* From battery_common.py */
					status = "okay";
					compatible = "samsung,sec-battery";
					battery,vendor = "Battery";
					battery,charger_name = "sec-direct-charger";
					battery,fuelgauge_name = "sm5714-fuelgauge";
					battery,technology = <2>; /* POWER_SUPPLY_TECHNOLOGY_LION */
					battery,chip_vendor = "LSI";
					battery,batt_data_version = <1>;
					battery,adc_check_count = <5>;
					battery,temp_check_type = <SEC_BATTERY_TEMP_CHECK_TEMP>;
					battery,usb_temp_check_type = <0>;
					battery,chg_temp_check_type = <SEC_BATTERY_TEMP_CHECK_TEMP>;
					battery,wpc_temp_check_type = <SEC_BATTERY_TEMP_CHECK_NONE>;
					battery,lrp_temp_check_type = <0>;
					battery,thermal_source = <SEC_BATTERY_THERMAL_SOURCE_ADC>;
					battery,usb_thermal_source = <0>;
					battery,chg_thermal_source = <SEC_BATTERY_THERMAL_SOURCE_ADC>;
					battery,wpc_thermal_source = <SEC_BATTERY_THERMAL_SOURCE_NONE>; /* SEC_BATTERY_THERMAL_SOURCE_NONE */
					battery,inbat_ocv_type =  <SEC_BATTERY_OCV_NONE>;
					battery,polling_time = <10 30 30 30 3600>;
					battery,cable_check_type = <SEC_BATTERY_CABLE_CHECK_PSY>;
					battery,cable_source_type = <SEC_BATTERY_CABLE_SOURCE_EXTERNAL>;
					battery,polling_type = <SEC_BATTERY_MONITOR_ALARM>; /* SEC_BATTERY_MONITOR_ALARM */
					battery,monitor_initial_count = <0>;
					battery,battery_check_type = <0>; /* SEC_BATTERY_CHECK_NONE */
					battery,ovp_uvlo_check_type = <SEC_BATTERY_OVP_UVLO_CHGPOLLING>; /* SEC_BATTERY_OVP_UVLO_CHGPOLLING */
					battery,temp_check_count = <1>;
					battery,usb_protection_temp = <610>;
					battery,temp_gap_bat_usb = <200>;
					battery,overheatlimit_threshold = <700>;
					battery,overheatlimit_recovery = <680>;
					battery,wire_warm_overheat_thresh = <500>;
					battery,wire_normal_warm_thresh = <420>;
					battery,wire_cool1_normal_thresh = <180>;
					battery,wire_cool2_cool1_thresh = <150>;
					battery,wire_cool3_cool2_thresh = <50>;
					battery,wire_cold_cool3_thresh = <0>;
					battery,wireless_warm_overheat_thresh = <500>;
					battery,wireless_normal_warm_thresh = <420>;
					battery,wireless_cool1_normal_thresh = <180>;
					battery,wireless_cool2_cool1_thresh = <150>;
					battery,wireless_cool3_cool2_thresh = <50>;
					battery,wireless_cold_cool3_thresh = <0>;
					battery,tx_high_threshold = <500>;
					battery,tx_high_recovery = <450>;
					battery,tx_low_threshold = <0>;
					battery,tx_low_recovery = <50>;
					battery,wire_warm_current = <1735>; /* Less than or equal to 0.72C */
					/* DC 4390 AFC 3150 */
					battery,wire_cool1_current = <0xa8c>; /* Less than or equal to 0.72C */
					battery,wire_cool2_current = <1150>; /* 0.238C */
					battery,wire_cool3_current = <450>; /* 0.1C */
					battery,wireless_warm_current = <1048>; /* 0.24C */
					battery,wireless_cool1_current = <3146>; /* 0.72C */
					battery,wireless_cool2_current = <1048>; /* 0.24C */
					battery,wireless_cool3_current = <437>; /* 0.1C */
					battery,full_check_type = <SEC_BATTERY_FULLCHARGED_FG_CURRENT>;
					battery,full_check_type_2nd = <SEC_BATTERY_FULLCHARGED_FG_CURRENT>;
					battery,full_check_count = <1>;
					battery,chg_gpio_full_check = <0>;
					battery,chg_polarity_full_check = <1>;
					battery,chg_high_temp = <600>;
					battery,chg_high_temp_recovery = <560>;
					battery,chg_input_limit_current = <1000>;
					battery,chg_charging_limit_current = <1400>;
					/* 45w pwr on, 45w pwr off, 25w pwr on, 25w pwr off */
					battery,dchg_high_temp = <0x258>;
					battery,dchg_high_temp_recovery = <0x230>;
					battery,dchg_high_batt_temp = <0x190>; /* DISABLED */
					battery,dchg_high_batt_temp_recovery = <0x17c>; /* DISABLED */
					battery,dchg_input_limit_current = <1000>;
					battery,dchg_charging_limit_current = <2000>;
					battery,wpc_temp_control_source = <1>;
					battery,wpc_high_temp = <400>;
					battery,wpc_high_temp_recovery = <380>;
					battery,wpc_input_limit_current = <800>;
					battery,wpc_charging_limit_current = <1000>;
					battery,wpc_temp_lcd_on_control_source = <1>;
					battery,wpc_lcd_on_input_limit_current = <800>;
					battery,wpc_store_high_temp = <360>;
					battery,wpc_store_high_temp_recovery = <340>;
					battery,wpc_store_charging_limit_current = <400>;
					battery,wpc_store_lcd_on_high_temp = <360>;
					battery,wpc_store_lcd_on_high_temp_rec = <300>;
					battery,wpc_store_lcd_on_charging_limit_current = <400>;
					battery,fcc_by_tx = <1200>;
					battery,sleep_mode_limit_current = <800>;
					battery,wc_full_input_limit_current = <100>;
					battery,ta_alert_wa;
					battery,mix_high_temp = <420>;
					battery,mix_high_chg_temp = <500>;
					battery,mix_high_temp_recovery = <390>;
					/* battery,usb_conn_slope_avg = <9>; */
					/* battery,enable_mix_v2; */
					/* if you want to use mix_v2 concept, add "battery,enable_mix_v2;" */
					battery,mix_v2_lrp_recov = <460>;
					battery,mix_v2_lrp_cond = <480>;
					battery,mix_v2_bat_cond = <480>;
					battery,mix_v2_chg_cond = <0>; /* 0 means no use chg thm condition */
					battery,mix_v2_dchg_cond = <0>; /* 0 means no use dchg thm condition */
					battery,full_condition_type = <(SEC_BATTERY_FULL_CONDITION_NOTIMEFULL | SEC_BATTERY_FULL_CONDITION_VCELL)>;
					battery,full_condition_soc = <93>;
					/* battery,full_condition_vcell = FV - 50mV set when variable is parsed */
					battery,recharge_check_count = <1>;
					battery,recharge_condition_type = <SEC_BATTERY_RECHARGE_CONDITION_VCELL>;
					battery,recharge_condition_soc = <98>;
					/* battery,recharge_condition_vcell = FV - 70mV set when variable is parsed */
					battery,charging_reset_time = <0>;
					battery,chg_float_voltage = <0x1144>;
					battery,pre_afc_work_delay = <2000>;
					battery,pre_wc_afc_work_delay = <4000>;
					battery,pre_afc_input_current = <500>;
					battery,pre_wc_afc_input_current = <500>;
					battery,swelling_high_rechg_voltage = <4050>;
					/*battery,swelling_low_rechg_voltage = FV - 150mA set when variable is parsed */
					battery,siop_icl = <1200>;
					battery,siop_fcc = <1800>;
					battery,siop_hv_icl = <675>;
					battery,siop_hv_icl_2nd = <550>;
					battery,siop_hv_fcc = <1800>;
					battery,siop_apdo_icl = <1000>;
					battery,siop_apdo_fcc = <2000>;
					battery,siop_wpc_icl = <600>;
					battery,siop_wpc_fcc = <1000 500 100>; /* siop_level 70 10 0 */
					battery,siop_hv_wpc_icl = <700>;
					battery,siop_hv_wpc_fcc = <1000 500 100>; /* siop_level 70 10 0 */
					battery,siop_store_hv_wpc_icl = <450>;
					battery,store_mode_buckoff;
					/* trig, recov */
					battery,temp_table_LRP_45W = <385 365>;
					battery,rp_current_rp1 = <500>;
					battery,rp_current_rp2 = <1500>;
					battery,rp_current_rp3 = <3000>;
					battery,rp_current_rdu_rp3 = <2100>;
					battery,rp_current_abnormal_rp3 = <1800>;
					battery,pd_charging_charge_power = <15000>;
					battery,max_charging_current = <0xa8c>;
					battery,store_mode_charging_max = <70>;
					battery,store_mode_charging_min = <60>;
					battery,wireless_cc_cv = <85>;
					battery,wireless_otg_input_current = <900>;
					battery,age_data_cycle = <0 0x12c 0x190 0x2bc 0x3e8>;
					battery,age_data_full_condition_soc = <93 92 91 90 89>;
					battery,age_data_common_offset = <0 0x14 0x28 0x6e>;
					/* battery,age_data_max_charging_current_offset = <0 100 200 300 400>; */
					/* cycle, chg_float_voltage, recharge_condition_vcell, full_condition_vcell, full_condition_soc, step charging condition */
					battery,age_data = <0 0x1144 0x10fe 0x1112 0x5d 0x12c 0x1130 0x10ea 0x10fe 0x5c 0x190 0x111c 0x10d6 0x10ea 0x5b 0x2bc 0x1108 0x10c2 0x10d6 0x5a 0x3e8 0x10d6 0x1090 0x10a4 0x59>;
					battery,health_condition_cycle = <900 1200 1500>;
					battery,health_condition_asoc = <0 0 0>; /* Default ASOC Disabled */
					battery,max_input_voltage = <9000>; /* mV */
					battery,max_input_current = <3000>; /* mA */
					battery,cisd_alg_index = <8>;
					battery,cisd_max_voltage_thr = <5000>; /* batttery ovp dettection voltage */
					battery,ignore_cisd_index = <0 0>;
					battery,ignore_cisd_index_d = <0 80>; /* Do not use BUCK_OFF_PER_DAY, DROP_SENSOR_PER_DAY */
					battery,expired_time = <9900>; /* 95 + 60 minutes = 155 */
					battery,recharging_expired_time = <5400>; /* 90 minutes */
					battery,battery_full_capacity = <5000>;
					battery,ttf_capacity = <4390>;
					battery,cv_data = <0xd27 0x352 0x690 0xbed 0x35c 0x5ef 0xaf2 0x366 0x5bc 0x9ca 0x370 0x576 0x844 0x37a 0x52f 0x816 0x384 0x4d4 0x735 0x38e 0x470 0x727 0x398 0x40b 0x704 0x3a2 0x39c 0x68c 0x3ac 0x33e 0x5f9 0x3b6 0x2c5 0x566 0x3c0 0x24c 0x410 0x3ca 0x1d4 0x3bd 0x3d4 0x120 0x340 0x3de 0x6b 0x2c9 0x3e8 0>;
					io-channels = <&s2mpu13_gpadc 2 &s2mpu13_gpadc 3>;
					io-channel-names = "adc-temp", "adc-chg-temp", "n/a", "n/a", "n/a";
					/* /home/dpi/qb5_8814/workspace/P4_1716/kernel/kmodule/battery/suwon/common/dts/a26xs/battery_common.dtsi */
					pinctrl-names = "default";
					battery,dchg_temp_check_type = <SEC_BATTERY_TEMP_CHECK_TEMP>;
					battery,dchg_thermal_source = <SEC_BATTERY_THERMAL_SOURCE_ADC>;
					battery,dctp_by_cgtp;
					battery,temp_table_adc = <0x133 0x168 0x1a5 0x1f8 0x23e 0x29e 0x2f9 0x37c 0x418 0x4c0 0x575 0x652 0x714 0x7f3 0x8d8 0x9b9 0xa9a 0xb6c 0xc32 0xce1 0xd85 0xe0d 0xe83>;
					battery,temp_table_data = <
						900 850 800 750 700 650 600 550 500 450
						400 350 300 250 200 150 100 50 0 (-50)
						(-100) (-150) (-200)
						>;
					battery,chg_temp_table_adc = <0x125 0x15d 0x198 0x1e6 0x22d 0x28d 0x2d7 0x360 0x3ff 0x49c 0x558 0x623 0x6e6 0x78e 0x8b4 0x975 0xa4b 0xac2 0xbd3 0xc7f 0xd4f 0xdee 0xe65>;
					battery,chg_temp_table_data = <
						900 850 800 750 700 650 600 550 500 450
						400 350 300 250 200 150 100 50 0 (-50)
						(-100) (-150) (-200)
						>;
					battery,full_condition_vcell = <0x1112>;
					battery,recharge_condition_vcell = <0x10fe>;
					battery,high_temp_float = <4200>;
					battery,low_temp_float = <0x1144>;
					battery,swelling_low_rechg_voltage = <0x10ae>;
					battery,chg_ocp_current = <0>;
					battery,max_charging_charge_power = <25000>; /* 25W */
					/* step charging option */
					battery,step_chg_type = <0>;
					/* direct step charging option */
					battery,dc_step_chg_type = <0xE9>;
					battery,dc_step_chg_charge_power = <22000>;
					battery,dc_step_chg_step = <3>;
					battery,dc_step_chg_cond_vol = <0xfd2 0x109a 0x1144>; /*<25w 3step> STEP_CHARGING_CONDITION_VOLTAGE */
					battery,dc_step_chg_val_vfloat = <0xfd2 0x109a 0x1144>; /* <25w 3step> STEP_CHARGING_CONDITION_FLOAT_VOLTAGE */
					battery,dc_step_chg_val_iout = <0x12c0 0xfd2 0xe10>; /* <25w 3step> */
					battery,dc_step_chg_iin_check_cnt = <3>;
					battery,dc_step_chg_cond_soc = <0x19 0x41 0x64>; /* <25w 3step> STEP_CHARGING_CONDITION_SOC */
					battery,standard_curr = <0xe10>;
					battery,ttf_hv_charge_current = <2450>;
					battery,ttf_dc25_charge_current = <3800>;
					battery,support_vpdo;
					battery,d2d_check_type = <2>;
				};

				/* #include "../abc_spec_manager_type1.dtsi" */
				/* From abc_spec_manager_type1.py */
				sec_abc {
					compatible = "samsung,sec_abc";
					status = "okay";

					abc_spec_type1 {
						module_list = "gpu", "gpu_qc", "gpu_qc", "camera", "camera", "vib";
						name_list = "gpu_fault", "gpu_fault", "gpu_page_fault", "mipi_overflow", "i2c_fail", "int_gnd_short";
						threshold_cnt = <20>, <2>, <20>, <1>, <1>, <25>;
						threshold_time = <1200>, <1200>, <1200>, <0>, <0>, <5>;
					};
				};

				/* #include "../ap_slsi_s5e8825.dtsi" */
				/* From ap_slsi_s5e8825.py */
				/* #include "../abc_common.dtsi" */
				/* From abc_common.py */
				abc_hub {
					compatible = "samsung,abc_hub";
					status = "okay";

					bootc {
						bootc,time_spec_user = <100000>; /* user binary user build */
						bootc,time_spec_eng = <150000>; /* user binary eng build */
						bootc,time_spec_fac = <100000>; /* factory binary */
					};
				};

				hall_ic: hall_ic {
					status = "okay";
					compatible = "hall_ic";
					pinctrl-names = "default";
					pinctrl-0 = <&hall_irq &certify_hall_irq>;
					hall_ic,debounce-interval = <0x32>;

					hall: hall {
						event = <0x15>;
						gpios = <&gpa0 1 1>;
					};

					certify_hall: certify_hall {
						event = <0x1b>;
						gpios = <&gpa0 0 1>;
					};
				};

				gw9558 {
					compatible = "goodix,gw9558x";
					reg = <0>;
					spi-max-frequency = <0x17d7840>;
					clocks = <&clock 0x4c3 &clock 0x4d5>;
					clock-names = "gate_spi_clk", "ipclk_spi";
					pinctrl-names = "default", "pins_poweron", "pins_poweroff";
					pinctrl-0 = <&gw9558x_ldo &gw9558x_rst>;
					pinctrl-1 = <&spi_fp_clk &spi_fp_cs &spi_fp_miso &spi_fp_mosi>;
					pinctrl-2 = <&spi_fp_bus_inactive &spi_fp_miso_inactive>;
					gpio-controller;
					#gpio-cells = <2>;
					goodix,gpio_pwr = <&gpp3 4 0>;
					goodix,gpio_reset = <&gpc3 0 0>;
					goodix,chip_id = "GW9558";
					goodix,position = "11.81,0.00,9.10,9.10,14.80,14.80,12.00,12.00,5.00";
					goodix,modelinfo = "A536";
					goodix,rb = "800,235,-1,D8D8D8,8C8C8C";

					controller-data {
						cs-gpio = <&gpp0 7 0>;
						samsung,spi-feedback-delay = <0>;
						samsung,spi-chip-select-mode = <0>;
					};
				};

				fixed_regulator0: fixed_regulator@0 {
					compatible = "regulator-fixed";
					regulator-name = "fixed_regulator0";
					gpio = <&gpf1 0 0>;
					pinctrl-names = "default";
					pinctrl-0 = <&ldo_gpio0>;
					enable-active-high;
				};

				/* #include "../dc_vibrator.dtsi" */
				/* From dc_vibrator.py */
				dc_vibrator {
					compatible = "samsung,dc_vibrator";
					status = "okay";
					dc_vib,motor_type = "COINDC";
					dc_vib,regulator_name = "dc_vib";
					dc_vib-supply = <&s_l21_reg>;
				};

				/*
				 * sm5714 battery device tree common
