				/* #include "../sec_direct_charger.dtsi" */
				/* From sec_direct_charger.py */
				sec-direct-charger {
					status = "okay";
					compatible = "samsung,sec-direct-charger";
					charger,battery_name = "battery";
					charger,main_charger = "sm5714-charger";
					charger,direct_charger = "sm5451-charger";
					charger,dchg_min_current = <2000>;
					charger,ta_alert_wa;
				};

