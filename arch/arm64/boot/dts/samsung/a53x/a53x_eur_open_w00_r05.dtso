					start_delay = <5000>; /* msec */
					init_delay = <5000>; /* msec */
					min_cap = <200>; /* 0.1 % */
					fixed_sc_cap = <900>; /* 0.1 % */
					max_icl = <3000>; /* mA */
					vfloat = <0x1144>;
				};

				/* sec_battery_cable
				 *   0	UNKNOWN,
				 *   1	NONE,
				 *   2	PREPARE_TA,
				 *   3	TA,
				 *   4	USB,
				 *   5	USB_CDP,
				 *   6	9V_TA,
				 *   7	9V_ERR,
				 *   8	9V_UNKNOWN,
				 *   9	12V_TA,
				 *  10	WIRELESS,
				 *  11	HV_WIRELESS,
				 *  12	PMA_WIRELESS,
				 *  13	WIRELESS_PACK,
				 *  14	CABLE_WIRELESS_HV_PACK,
				 *  15	WIRELESS_STAND,
				 *  16	WIRELESS_HV_STAND,
				 *  17	QC20,
				 *  18	QC30,
				 *  19	PDIC,
				 *  20	UARTOFF,
				 *  21	OTG,
