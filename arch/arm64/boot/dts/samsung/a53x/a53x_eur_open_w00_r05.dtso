				 *  33  WIRELESS_TX,
				 *  34	HV_WIRELESS_20,
				 *  35	HV_WIRELESS_20_LIMIT,
				 *  36	WIRELESS_FAKE,
				 *  37  PREPARE_WIRELESS_20,
				 *  38	CABLE_PDIC_APDO,
				 *  39  CABLE_POGO,
				 *  40  CABLE_POGO_9V,
				 *  41  FPDO_DC,
				 *  42	CABLE_MAX,
				 */
				sec_battery_cable: cable-info {
					default_input_current = <1800>;
					default_charging_current = <2100>;
					full_check_current_1st = <750>;
