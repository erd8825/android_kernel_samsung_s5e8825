&hsi2c_13 {
	gpios = <&gpp3 3 0 &gpp3 2 0>;
	pinctrl-0 = <&grip_i2c_sda
				&grip_i2c_scl
	#if 0
				&grip_ldo_en
	#endif
				>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";

	sx938x: sx938x-i2c@28 {
		compatible = "sx938x";
		reg = <0x28>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&grip_int>;
		interrupt-parent = <&gpa1>;
		interrupts = <3 0 0>;
		sx938x,dvdd_vreg_name = "VDD_GRIP_3P3";
		sx938x,nirq-gpio = <&gpa1 3 0>;
		Semtech,reg-num = <0x18>;
		sx938x,irq_enable_reg = <0xe>;
		sx938x,irqcfg_reg = <0>;
		sx938x,gnrl_ctrl0_reg = <3>;
		sx938x,gnrl_ctrl1_reg = <0>;
		sx938x,gnrl_ctrl2_reg = <0x19>;
		sx938x,afe_ctrl1_reg = <1>;
		sx938x,afe_param0_phr_reg = <0xc>;
		sx938x,afe_param1_phr_reg = <0x46>;
		sx938x,afe_param0_phm_reg = <0xf>;
		sx938x,afe_param1_phm_reg = <0x26>;
		sx938x,proxctrl0_phr_reg = <9>;
		sx938x,proxctrl0_phm_reg = <0xa>;
		sx938x,proxctrl1_reg = <0x20>;
		sx938x,proxctrl2_reg = <0x60>;
		sx938x,proxctrl3_reg = <0xd>;
		sx938x,proxctrl4_reg = <0x15>;
		sx938x,proxctrl5_reg = <0x12>;
		sx938x,refcorr0_reg = <0>;
		sx938x,refcorr1_reg = <0>;
		sx938x,usefilter0_reg = <0>;
		sx938x,usefilter1_reg = <0>;
		sx938x,usefilter2_reg = <0>;
		sx938x,usefilter3_reg = <0>;
		sx938x,usefilter4_reg = <0>;
	};
};

/* #include "../sensors_isg6320.dtsi" */
/* From sensors_isg6320.py */
&pinctrl_6 {

	grip_i2c_sda: grip-i2c-sda {
		samsung,pins = "gpp3-3";
		samsung,pin-function = <0x3>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <0x0>;
		samsung,pin-pud-pdn = <0>;
	};

	grip_i2c_scl: grip-i2c-scl {
		/* /home/dpi/qb5_8814/workspace/P4_1716/kernel/kmodule/sensors/isg6320/dts/isg6320_hwparam.a26xs.dtsi */
		samsung,pins = "gpp3-2";
		samsung,pin-function = <0x3>;
		samsung,pin-pud = <3>;
		samsung,pin-drv = <0x0>;
		samsung,pin-pud-pdn = <0>;
	};
};

&pinctrl_0 {

	grip_int: grip-int {
		samsung,pins = "gpa1-3";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0x0>;
	};
};

/* #include "../pmic_S2MPU13.dtsi" */
/* From pmic_S2MPU13.py */
&pinctrl_0 {

	pm_wrstbi: pm-wrstbi {
		samsung,pins = "gpc1-0";
		samsung,pin-con-pdn = <3>;
		samsung,pin-pud-pdn = <0>;
	};
};

&pinctrl_6 {

	smpl_warn: smpl-warn {
		samsung,pins = "gpg0-0";
		samsung,pin-function = <15>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
		samsung,pin-con-pdn = <2>;
		samsung,pin-pud-pdn = <0>;
	};
};

&acpm_mfd_bus0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	s2mpu13mfd@1f {
		compatible = "samsung,s2mpu13mfd";
		acpm-ipc-channel = <2>;
		s2mpu13,wakeup = "enabled";
		reg = <0x1f>;
		interrupts = <0 24 4>;
		interrupt-parent = <&gic>;
		pinctrl-names = "default";
		pinctrl-0 = <&pm_wrstbi &smpl_warn>;
		gpios = <&gpg0 0 0>;
		/* RTC: wtsr/smpl */
		wtsr_en = "enabled"; /* enable */
		smpl_en = "enabled"; /* enable */
		wtsr_timer_val = <3>; /* 1000ms */
		smpl_timer_val = <0>; /* 100ms */
		sub_smpl_en = "enabled"; /* enable */
		check_jigon = <0>; /* do not check jigon */
		/* RTC: If it's first boot, reset rtc to 1/1/2021 12:00:00(Wed) */
		init_time,sec = <0>;
		init_time,min = <0>;
		init_time,hour = <12>;
		init_time,mday = <1>;
		init_time,mon = <0>;
		init_time,year = <121>;
		init_time,wday = <5>;
		/* SMPL_WARN */
		smpl_warn_en = <1>; /* 1 : enable , 0 : disable */
		/* SEL_VGPIO0M~18M (CONTROL_SEL#) */
		sel_vgpio = <0x24 0x32 0x11 0x39 0x33 0x33 0x22 0x33 0x24 0xB1
			0xC1 0xB1 0x77 0x5B 0x5E 0xCC 0x73 0x33 0xF3>;

		s2mpu13_gpadc: s2mpu13-gpadc {
			#io-channel-cells = <1>;
			io-channel-ranges;
			acpm-ipc-channel = <10>;
		};

		s2mpu13_gpio: s2mpu13-gpio {
			gpio-controller;
			#gpio-cells = <2>;
			samsung,npins = <5>;
			status = "okay";
		};

		s2mpu13-keys {

			button@1 {
				label = "pmic-keys: KEY_POWER";
				linux,code = <116>;
				wakeup = <1>;
			};
		};

		regulators {

			b1_reg: BUCK1 {
				regulator-name = "vdd_g3d";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <1>; /* V_PWREN_G3D */
			};

			/*
						b2_reg: BUCK2 {
							regulator-name = "vdd_cpu_cp";
							regulator-min-microvolt = <400000>;
							regulator-max-microvolt = <1300000>;
							regulator-always-on;
							regulator-ramp-delay = <6000>;
							regulator-initial-mode = <3>;
						};

						b3_reg: BUCK3 {
							regulator-name = "vdd_cp";
							regulator-min-microvolt = <400000>;
							regulator-max-microvolt = <1300000>;
							regulator-always-on;
							regulator-ramp-delay = <6000>;
							regulator-initial-mode = <3>;
						};
			 */
			b4_reg: BUCK4 {
				regulator-name = "vdd_mem_vdd2";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <6000>;
				regulator-initial-mode = <3>; /* V_PWREN_MIF */
			};

			b5_reg: BUCK5 {
				regulator-name = "vdd2_int";
