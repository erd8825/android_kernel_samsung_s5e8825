#include "s5e8825.a53x_common.dtsi"
#include "s5e8825-a53x_pm_00.dtsi"
#include "camera/s5e8825-a53x-camera_00.dtsi"

/ {
	fragment@model {
		target-path = "/";
		__overlay__ {
			model = "Samsung A53X EUR OPEN BRINGUP based on S5E8825";
		}; /* end of __overlay__ */
	}; /* end of fragment */
}; /* end of root */

&serial_0 {
	status = "okay";
};

&pinctrl_0 {

	dmic1_en: dmic1-en {
		samsung,pins = "gpc2-0";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <1>;
	};

	dmic1_en_idle: dmic1-en-idle {
		samsung,pins = "gpc2-0";
		samsung,pin-function = <0>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <0>;
	};

	dmic2_en: dmic2-en {
		samsung,pins = "gpc3-0";
		samsung,pin-function = <1>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <1>;
	};

	dmic2_en_idle: dmic2-en-idle {
		samsung,pins = "gpc3-0";
		samsung,pin-function = <0>;
		samsung,pin-pud = <0>;
		samsung,pin-val = <0>;
	};
};

&vts {
	pinctrl-names = "dmic0_default", "dmic1_default", "dmic2_default", "amic0_default", "amic1_default", "amic2_default", "dmic0_idle", "dmic1_idle", "dmic2_idle", "default";
	pinctrl-0 = <&dmic_bus_clk0 &dmic_pdm0_bus &dmic1_en>;
	pinctrl-1 = <&dmic_bus_clk2 &dmic_pdm2_bus &dmic2_en>;
	pinctrl-2 = <&dmic_bus_clk2 &dmic_pdm2_bus>;
	pinctrl-3 = <&dmic_bus_clk0 &amic_pdm0_bus>;
	pinctrl-4 = <&dmic_bus_clk1 &amic_pdm1_bus>;
	pinctrl-5 = <&dmic_bus_clk2 &amic_pdm2_bus>;
	pinctrl-6 = <&dmic_bus_clk0_idle &dmic_pdm0_idle &dmic1_en_idle>;
	pinctrl-7 = <&dmic_bus_clk2_idle &dmic_pdm2_idle &dmic2_en_idle>;
	pinctrl-8 = <&dmic_bus_clk2_idle &dmic_pdm2_idle>;
	pinctrl-9;
};

&hsi2c_7 {

	tfa98xx@34 {
		pinctrl-names;
		pinctrl-0;
		irq-gpio;
	};

	tfa98xx@35 {
		pinctrl-names = "default";
		pinctrl-0 = <&amp_en>;
		irq-gpio;
	};
};
